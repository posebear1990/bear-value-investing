{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "InvestmentThesisSchema",
  "description": "Strict JSON schema for persisting investment thesis state and exit conditions for a ticker.",
  "type": "object",
  "properties": {
    "version": {
      "type": "string",
      "default": "1.0.0"
    },
    "ticker": {
      "type": "string"
    },
    "company_name": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date"
    },
    "last_updated": {
      "type": "string",
      "format": "date"
    },
    "category": {
      "type": "string",
      "enum": ["GROWTH", "STABLE_VALUE", "CYCLICAL"]
    },
    "entry_price": {
      "type": "number"
    },
    "current_tranche_percent": {
      "type": "number",
      "description": "Current position size as percentage of total target position (e.g. 20 for 20%)."
    },
    "moat_assessment": {
      "type": "string"
    },
    "initial_thesis_points": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "valuation_assumptions": {
      "type": "object",
      "properties": {
        "dcf_growth_rate_5yr": { "type": "number" },
        "dcf_wacc": { "type": "number" },
        "pe_percentile": { "type": "number" },
        "net_cash_ratio": { "type": "number" },
        "total_shareholder_yield": { "type": "number" }
      }
    },
    "exit_conditions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "history_log": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "date": { "type": "string" },
          "action": { "type": "string", "enum": ["INIT_BUY", "ADD", "TRIM", "SELL", "REVIEW"] },
          "rationale": { "type": "string" }
        },
        "required": ["date", "action", "rationale"]
      }
    }
  },
  "required": [
    "version",
    "ticker",
    "company_name",
    "created_at",
    "category",
    "entry_price",
    "initial_thesis_points",
    "exit_conditions"
  ]
}
